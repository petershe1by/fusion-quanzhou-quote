{
  "manifest_version": 3,
  "name": "Fusion 铨洲 6.8 活动报价",
  "description": "接收 Fusion 的批量 STEP，复用铨洲智造 6.8 起打样页面。",
  "version": "1.1.0",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.gy2025.com/*", "https://gy2025.com/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [
    {"matches": ["https://www.gy2025.com/*", "https://gy2025.com/*"], "js": ["activity.js"]}
  ]
}
